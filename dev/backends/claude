#!/usr/bin/env bash

# Claude Code backend for dev/devloop. Implements the backend contract
# described in docs/devloop-workflow.md:
#
#   dev/backends/claude implement <worktree-path> <prompt-file>
#   dev/backends/claude review <pr-number> <issue-number>
#
# Exit codes: 0 = success, 1 = failed, 75 = paused (daily usage limit hit;
# writes $DEVLOOP_STATE_DIR/paused and leaves everything else untouched).

set -euo pipefail

readonly PAUSE_EXIT_CODE=75
readonly USAGE_LIMIT_PATTERN='usage limit|limit reset|resets at|rate limit exceeded'

die() {
  printf 'error: %s\n' "$*" >&2
  exit 1
}

mark_paused() {
  local detail="$1"
  [[ -n "${DEVLOOP_STATE_DIR:-}" ]] || die "DEVLOOP_STATE_DIR must be set by the orchestrator"
  mkdir -p "$DEVLOOP_STATE_DIR"
  printf '%s: %s\n' "$(date -u +%FT%TZ)" "$detail" >"$DEVLOOP_STATE_DIR/paused"
  # Print at the moment it happens, not just next time doctor is checked — in continuous
  # `dev/devloop run` mode this is otherwise the one stop condition that exits with no
  # visible explanation at all.
  printf 'paused: %s\n' "$detail" >&2
}

# NOTE: the exact wording Claude Code uses when a subscription's daily usage
# limit is hit hasn't been confirmed against a real occurrence yet. If this
# heuristic misses it, tighten USAGE_LIMIT_PATTERN once you see the real
# message in a paused-but-not-detected run.
looks_like_usage_limit() {
  grep -qiE "$USAGE_LIMIT_PATTERN" "$1"
}

implement() {
  local worktree="$1" prompt_file="$2" output_file rc

  [[ -d "$worktree" ]] || die "worktree not found: $worktree"
  [[ -f "$prompt_file" ]] || die "prompt file not found: $prompt_file"

  output_file="$(mktemp)"
  # NOT `trap ... EXIT` here: that fires at actual process exit, not when this function
  # returns. On a clean success this function falls through to a plain return (no early
  # `exit`), so by the time the trap runs, output_file's `local` scope is long gone and the
  # trap body fails with "output_file: unbound variable" under set -u. Confirmed live: this
  # was invisible until the first real success of this backend, because every prior run had
  # exited early (via `exit "$PAUSE_EXIT_CODE"` or `exit 1`) while output_file was still in
  # scope. Explicit rm -f at every exit point sidesteps the whole scoping question.

  set +e
  (
    cd "$worktree"
    claude -p "$(cat "$prompt_file")" \
      --permission-mode acceptEdits \
      --permission-prompts none \
      --allowedTools "Bash(go build *) Bash(go run *) Bash(go test *) Bash(go vet *) Bash(gofmt *) Edit Write Read Glob Grep" \
      --output-format json
  ) >"$output_file" 2>&1
  rc=$?
  set -e

  if looks_like_usage_limit "$output_file"; then
    mark_paused "implement backend hit usage limit"
    rm -f "$output_file"
    exit "$PAUSE_EXIT_CODE"
  fi

  cat "$output_file"
  rm -f "$output_file"
  [[ "$rc" -eq 0 ]] || exit 1
}

review() {
  local pr_number="$1" issue_number="$2" output_file progress_file rc findings

  # --json prints the raw bugs.json array on stdout; everything else (progress, "posting to
  # PR...", any error text) goes to stderr. Keep them separate — merging them with 2>&1 (as an
  # earlier version of this did) makes stdout unparseable JSON, and `jq` failing to parse it
  # was silently treated as "1 finding" via a `|| printf 1` fallback. Confirmed live: a real
  # zero-finding review got misreported as 1 finding and wrongly sent the issue to
  # needs-attention this way.
  output_file="$(mktemp)"
  progress_file="$(mktemp)"
  # Not `trap ... EXIT` (see implement()'s comment on the same pattern) — explicit rm -f at
  # every exit point instead, so cleanup never depends on which scope is active when the
  # process actually exits.

  set +e
  claude ultrareview "$pr_number" --json --post >"$output_file" 2>"$progress_file"
  rc=$?
  set -e

  cat "$progress_file" >&2

  if looks_like_usage_limit "$output_file" || looks_like_usage_limit "$progress_file"; then
    mark_paused "review backend hit usage limit"
    rm -f "$output_file" "$progress_file"
    exit "$PAUSE_EXIT_CODE"
  fi

  if [[ "$rc" -ne 0 ]]; then
    cat "$output_file" >&2
    rm -f "$output_file" "$progress_file"
    exit 1
  fi

  findings="$(jq 'length' "$output_file")" ||
    die "ultrareview --json output was not valid JSON: $(cat "$output_file")"
  cat "$output_file"
  # Findings for dev/devloop's next fix round (see "Backend contract" in
  # docs/devloop-workflow.md). Only written when there are findings, never on a backend
  # failure above, so the orchestrator can tell the two apart.
  if [[ "$findings" -gt 0 && -n "${DEVLOOP_REVIEW_FEEDBACK_FILE:-}" ]]; then
    jq . "$output_file" >"$DEVLOOP_REVIEW_FEEDBACK_FILE"
  fi
  rm -f "$output_file" "$progress_file"

  if [[ "$findings" -eq 0 ]]; then
    printf 'ultrareview: no findings on PR #%s (issue #%s)\n' "$pr_number" "$issue_number"
    exit 0
  else
    printf 'ultrareview: %s finding(s) on PR #%s (issue #%s)\n' "$findings" "$pr_number" "$issue_number"
    exit 1
  fi
}

main() {
  local command="${1:-}"
  case "$command" in
    implement) shift; [[ $# -eq 2 ]] || die "usage: implement <worktree-path> <prompt-file>"; implement "$@" ;;
    review) shift; [[ $# -eq 2 ]] || die "usage: review <pr-number> <issue-number>"; review "$@" ;;
    *) die "usage: $0 implement <worktree-path> <prompt-file> | review <pr-number> <issue-number>" ;;
  esac
}

main "$@"
