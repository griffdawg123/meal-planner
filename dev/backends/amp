#!/usr/bin/env bash

# Amp orb backend for dev/devloop. Implements the backend contract described in
# docs/devloop-workflow.md:
#
#   dev/backends/amp implement <worktree-path> <prompt-file>
#   dev/backends/amp review <pr-number> <issue-number>
#
# Exit codes: 0 = success, 1 = failed, 75 = paused (credits/quota exhausted; writes
# $DEVLOOP_STATE_DIR/paused and leaves everything else untouched).
#
# implement dispatches to a real Amp orb via dev/orb (dev/orb start, then dev/orb sync once
# the orb is done) because it needs a full checkout to edit files and run tests in — this is
# genuinely async, unlike review below.
#
# review does NOT use an orb. It hands the PR diff and issue text to a synchronous, local
# `amp -x` call (no repo checkout needed for a text review) and posts the result as a PR
# comment itself, since an orb must never hold GitHub credentials (see AGENTS.md) and this
# way it doesn't need any.

set -euo pipefail

readonly PAUSE_EXIT_CODE=75
readonly EXHAUSTED_PATTERN='credit|quota exceeded|insufficient credits|rate limit exceeded|out of credits'

die() {
  printf 'error: %s\n' "$*" >&2
  exit 1
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || die "required command not found: $1"
}

mark_paused() {
  local detail="$1"
  [[ -n "${DEVLOOP_STATE_DIR:-}" ]] || die "DEVLOOP_STATE_DIR must be set by the orchestrator"
  mkdir -p "$DEVLOOP_STATE_DIR"
  printf '%s: %s\n' "$(date -u +%FT%TZ)" "$detail" >"$DEVLOOP_STATE_DIR/paused"
  # Print at the moment it happens, not just next time doctor is checked — in continuous
  # `dev/devloop run` mode this is otherwise the one stop condition that exits with no
  # visible explanation at all.
  printf 'paused: %s\n' "$detail" >&2
}

# NOTE: like the claude backend's usage-limit pattern, this hasn't been confirmed against a
# real exhausted-credits message — tighten it the first time this misses or misfires.
looks_like_exhausted() {
  grep -qiE "$EXHAUSTED_PATTERN" "$1"
}

# Confirmed against a real, already-finished orb thread's export payload: the completion
# signal lives at meta.lastKnownAgentState.state, value "idle" once the agent has finished a
# turn and is waiting for the next one. What value(s) it reports mid-task (still generating,
# running a tool) are NOT confirmed — this was checked against a thread that was already done,
# not one caught mid-run. That's fine for this function's actual job (poll until idle), but if
# it ever reports "idle" too early (e.g. between tool calls rather than only at the end of the
# whole task), implement() would sync prematurely. Watch the first few real runs for that.
orb_thread_is_done() {
  local thread_id="$1" payload
  payload="$(amp threads export "$thread_id" 2>/dev/null)" || return 1
  printf '%s' "$payload" | jq -e '.meta.lastKnownAgentState.state == "idle"' >/dev/null 2>&1
}

implement() {
  local worktree="$1" prompt_file="$2"
  local dev_orb start_output thread_id
  local timeout_seconds interval elapsed

  [[ -d "$worktree" ]] || die "worktree not found: $worktree"
  [[ -f "$prompt_file" ]] || die "prompt file not found: $prompt_file"
  [[ -n "${DEVLOOP_STATE_DIR:-}" ]] || die "DEVLOOP_STATE_DIR must be set by the orchestrator"
  require_command amp
  require_command jq

  dev_orb="$worktree/dev/orb"
  [[ -x "$dev_orb" ]] || die "dev/orb not found or not executable in $worktree"

  set +e
  start_output="$(cd "$worktree" && "$dev_orb" start "$(cat "$prompt_file")" 2>&1)"
  local rc=$?
  set -e
  printf '%s\n' "$start_output"

  if looks_like_exhausted <(printf '%s' "$start_output"); then
    mark_paused "implement backend (dev/orb start) reported exhausted credits/quota"
    exit "$PAUSE_EXIT_CODE"
  fi
  [[ "$rc" -eq 0 ]] || exit 1

  thread_id="$(printf '%s' "$start_output" | grep -Eo 'T-[[:alnum:]-]+' | tail -n1)"
  [[ -n "$thread_id" ]] || die "could not read an Amp thread ID from dev/orb start output"

  timeout_seconds="${DEVLOOP_AMP_TIMEOUT_SECONDS:-2700}"
  interval=30
  elapsed=0
  while (( elapsed < timeout_seconds )); do
    if orb_thread_is_done "$thread_id"; then
      break
    fi
    sleep "$interval"
    elapsed=$((elapsed + interval))
  done
  if (( elapsed >= timeout_seconds )); then
    die "orb thread $thread_id did not report completion within ${timeout_seconds}s (see the UNVERIFIED note on orb_thread_is_done above — this may be a detection bug, not a stuck orb); sync it manually once you've confirmed it's done: (cd $worktree && dev/orb sync $thread_id)"
  fi

  # NOT `dev/orb sync` here: it calls bare `amp sync <thread>`, which defaults to *live*,
  # continuous mirroring ("keep watching for more changes") and never exits on its own — it
  # only becomes a one-shot apply-and-exit with --apply. That's fine for a human running
  # `dev/orb sync` interactively (they can watch it settle and Ctrl+C), but it hangs forever
  # headless. --checkout avoids a second hang risk: without it, a checkout that "differs" from
  # the thread's commit triggers an interactive prompt with no TTY to answer it. The worktree
  # is freshly created for this task and touched by nothing else, so checking out the thread's
  # commit unconditionally is safe here.
  (cd "$worktree" && amp sync --apply "$thread_id" --checkout)
}

review() {
  local pr_number="$1" issue_number="$2"
  local diff issue_title issue_body prompt output rc

  require_command gh
  require_command amp

  diff="$(gh pr diff "$pr_number")" || die "could not fetch diff for PR #$pr_number"
  issue_title="$(gh issue view "$issue_number" --json title -q .title 2>/dev/null || true)"
  issue_body="$(gh issue view "$issue_number" --json body -q .body 2>/dev/null || true)"

  prompt="$(cat <<EOF
Review this pull request against the GitHub issue it claims to close. Look for
bugs and for places the implementation doesn't actually satisfy the issue,
not just style.

## Issue #$issue_number: $issue_title

$issue_body

## Diff

\`\`\`diff
$diff
\`\`\`

End your response with exactly one line, verbatim, and nothing after it:
DEVLOOP_VERDICT: PASS
or
DEVLOOP_VERDICT: CHANGES_REQUESTED
EOF
)"

  set +e
  output="$(amp --no-color -x "$prompt" 2>&1)"
  rc=$?
  set -e

  if looks_like_exhausted <(printf '%s' "$output"); then
    mark_paused "review backend reported exhausted credits/quota"
    exit "$PAUSE_EXIT_CODE"
  fi
  if [[ "$rc" -ne 0 ]]; then
    printf '%s\n' "$output" >&2
    exit 1
  fi

  printf '%s\n' "$output"
  gh pr comment "$pr_number" --body "$output" >/dev/null

  if printf '%s' "$output" | grep -q 'DEVLOOP_VERDICT: *PASS'; then
    exit 0
  else
    exit 1
  fi
}

main() {
  local command="${1:-}"
  case "$command" in
    implement) shift; [[ $# -eq 2 ]] || die "usage: implement <worktree-path> <prompt-file>"; implement "$@" ;;
    review) shift; [[ $# -eq 2 ]] || die "usage: review <pr-number> <issue-number>"; review "$@" ;;
    *) die "usage: $0 implement <worktree-path> <prompt-file> | review <pr-number> <issue-number>" ;;
  esac
}

main "$@"
